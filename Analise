# =========================
# DIAGRAMA DE LEXIS (CORRIGIDO)
# =========================
gerar_lexis <- function(resultado) {
  
  # Pegamos o código do país que está guardado dentro da lista 'resultado'
  p_codigo <- resultado$pais
  
  # Buscando dados de óbitos por idade e ano
  dados_lexis <- dbGetQuery(con, glue("
    SELECT t.ano, a.idade, SUM(fo.obitos) as obitos
    FROM fato_obitos fo
    JOIN dim_pais c ON fo.id_pais = c.id_pais
    JOIN dim_tempo t ON fo.id_tempo = t.id_tempo
    JOIN dim_idade a ON fo.id_idade = a.id_idade
    WHERE c.codigo_geo = '{p_codigo}'
      AND fo.id_sexo = 3
    GROUP BY t.ano, a.idade
    ORDER BY t.ano, a.idade
  "))
  
  ggplot(dados_lexis, aes(x = ano, y = idade)) +
    geom_tile(aes(fill = obitos)) +
    geom_abline(intercept = seq(-2050, 2050, by = 10), slope = 1, 
                alpha = 0.2, linetype = "dotted") +
    scale_fill_viridis_c(option = "magma", direction = -1) +
    theme_minimal() +
    labs(
      title = paste("Diagrama de Lexis -", p_codigo),
      subtitle = "Linhas diagonais indicam coortes (gerações)",
      x = "Ano", y = "Idade", fill = "Óbitos"
    )
}


