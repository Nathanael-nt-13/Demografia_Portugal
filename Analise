gerar_grafico_lx <- function(resultado) {
  ggplot(resultado$tabela_vida, aes(x = idade, y = lx, color = sexo)) +
    geom_line(size = 1) +
    theme_minimal() +
    scale_color_manual(values = c("F" = "darkred", "M" = "darkblue")) +
    labs(title = "Função de Sobrevivência (lx)",
         subtitle = "Número de sobreviventes de uma coorte de 100.000",
         x = "Idade", y = "Sobreviventes")
}

gerar_grafico_ex <- function(resultado) {
