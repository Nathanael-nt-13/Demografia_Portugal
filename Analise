# =========================
# FUNÇÃO PRINCIPAL
# =========================
analisar_pais <- function(codigo_pais, ano_tabela_vida = NULL) {
  
  filtro_ano <- if (!is.null(ano_tabela_vida)) {
    glue("AND t.ano = {ano_tabela_vida}")
  } else {
    ""
  }
  
  # =========================
  # POPULAÇÃO
  # =========================
  pop <- dbGetQuery(con, glue("
    SELECT t.ano, SUM(p.populacao) as pop
    FROM fato_populacao p
    JOIN dim_pais c ON p.id_pais = c.id_pais
    JOIN dim_tempo t ON p.id_tempo = t.id_tempo
    JOIN dim_sexo s ON p.id_sexo = s.id_sexo
    WHERE c.codigo_geo = '{codigo_pais}'
      AND s.codigo_sexo = 'T'
    GROUP BY t.ano
    ORDER BY t.ano
  ")) %>%
    mutate(
      growth = ifelse(lag(pop) == 0 | is.na(lag(pop)),
                      NA,
                      (pop - lag(pop)) / lag(pop) * 100)
    )
  
  # =========================
  # TÁBUA DE VIDA
  # =========================
  tabela_vida <- dbGetQuery(con, glue("
    WITH base AS (
        SELECT 
            t.ano,
            a.idade,
            s.codigo_sexo AS sexo,
            fp.populacao,
            COALESCE(fo.obitos, 0) AS obitos,
            LEAST(
              (COALESCE(fo.obitos,0)::numeric /
              NULLIF(fp.populacao + (0.5 * COALESCE(fo.obitos,0)),0)),
              1
            ) AS qx
        FROM fato_populacao fp
        JOIN dim_tempo t ON fp.id_tempo = t.id_tempo
        JOIN dim_idade a ON fp.id_idade = a.id_idade
        JOIN dim_sexo s ON fp.id_sexo = s.id_sexo
        JOIN dim_pais c ON fp.id_pais = c.id_pais
        LEFT JOIN fato_obitos fo
          ON fo.id_pais = fp.id_pais
         AND fo.id_tempo = fp.id_tempo
         AND fo.id_idade = fp.id_idade
         AND fo.id_sexo = fp.id_sexo
        WHERE c.codigo_geo = '{codigo_pais}'
        {filtro_ano}
        AND s.id_sexo IN (1,2)
    ),
    tabela AS (
        SELECT *,
        100000 * COALESCE(
            EXP(SUM(LN(NULLIF(1 - qx, 0)))
            OVER (PARTITION BY sexo ORDER BY idade
            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING)),1) AS lx
        FROM base
    )
    SELECT 
        ano, sexo, idade,
        ROUND(lx,0) as lx,
        ROUND(
          (SUM(lx) OVER (PARTITION BY sexo ORDER BY idade DESC))
          / NULLIF(lx,0),2
        ) AS ex
    FROM tabela
    ORDER BY sexo, idade
  "))
  
  # =========================
  # ESTRUTURA ETÁRIA
  # =========================
  estrutura <- dbGetQuery(con, glue("
    SELECT t.ano,
      SUM(CASE WHEN a.idade < 15 THEN fp.populacao ELSE 0 END) AS jovem,
      SUM(CASE WHEN a.idade BETWEEN 15 AND 64 THEN fp.populacao ELSE 0 END) AS ativo,
      SUM(CASE WHEN a.idade >= 65 THEN fp.populacao ELSE 0 END) AS idoso
    FROM fato_populacao fp
    JOIN dim_tempo t ON fp.id_tempo = t.id_tempo
    JOIN dim_idade a ON fp.id_idade = a.id_idade
    JOIN dim_pais c ON fp.id_pais = c.id_pais
    WHERE c.codigo_geo = '{codigo_pais}'
      AND fp.id_sexo = 3
    GROUP BY t.ano
    ORDER BY t.ano
  ")) %>%
    mutate(
      indice_envelhecimento = (idoso / jovem) * 100,
      razao_dependencia = (jovem + idoso) / ativo * 100
    )
  
  # =========================
  # MORTALIDADE
  # =========================
  mortalidade <- dbGetQuery(con, glue("
    WITH pop AS (
      SELECT id_tempo, id_pais, SUM(populacao) pop
      FROM fato_populacao
      WHERE id_sexo = 3
      GROUP BY id_tempo, id_pais
    ),
    obitos AS (
      SELECT id_tempo, id_pais, SUM(obitos) d
      FROM fato_obitos
      WHERE id_sexo = 3
      GROUP BY id_tempo, id_pais
    )
    SELECT t.ano,
      ROUND((d.d::numeric / NULLIF(p.pop,0))*1000,2) as taxa_mortalidade
    FROM pop p
    JOIN obitos d USING(id_tempo,id_pais)
    JOIN dim_tempo t ON t.id_tempo = p.id_tempo
    JOIN dim_pais c ON c.id_pais = p.id_pais
    WHERE c.codigo_geo = '{codigo_pais}'
    ORDER BY t.ano
  "))
  
  # =========================
  # TFT
  # =========================
  tft <- dbGetQuery(con, glue("
    SELECT 
        t.ano,
        ROUND(SUM(fn.nascimentos::numeric / NULLIF(fp.populacao,0)),2) as tft
    FROM fato_nascimentos fn
    JOIN dim_tempo t ON fn.id_tempo = t.id_tempo
    JOIN dim_idade a ON fn.id_idade_mae = a.id_idade
    JOIN dim_pais c ON fn.id_pais = c.id_pais
    JOIN fato_populacao fp
      ON fp.id_pais = fn.id_pais
     AND fp.id_tempo = fn.id_tempo
     AND fp.id_idade = fn.id_idade_mae
    WHERE c.codigo_geo = '{codigo_pais}'
      AND fp.id_sexo = 2
      AND fn.id_sexo = 3
      AND a.idade BETWEEN 15 AND 49
    GROUP BY t.ano
    ORDER BY t.ano
  "))
  
  # =========================
  # MIGRAÇÃO
  # =========================
  migracao <- dbGetQuery(con, glue("
    SELECT 
      t.ano,
      SUM(CASE WHEN m.tipo_fluxo = 'entrada' THEN m.migrantes ELSE 0 END) AS imigracao,
      SUM(CASE WHEN m.tipo_fluxo = 'saida' THEN m.migrantes ELSE 0 END) AS emigracao,
      SUM(CASE 
            WHEN m.tipo_fluxo = 'entrada' THEN m.migrantes 
            WHEN m.tipo_fluxo = 'saida' THEN -m.migrantes 
          END) AS saldo_migratorio
    FROM fato_migracao m
    JOIN dim_tempo t ON m.id_tempo = t.id_tempo
    JOIN dim_pais c ON m.id_pais = c.id_pais
    WHERE c.codigo_geo = '{codigo_pais}'
      AND m.id_sexo = 3
    GROUP BY t.ano
    ORDER BY t.ano
  "))
  
  return(list(
    pais = codigo_pais,
    ano = ano_tabela_vida,
    populacao = pop,
    tabela_vida = tabela_vida,
    estrutura = estrutura,
    mortalidade = mortalidade,
    tft = tft,
    migracao = migracao
  ))
}

# =========================
# PIRÂMIDE ETÁRIA
# =========================
gerar_piramide <- function(resultado) {
  
  codigo_pais <- resultado$pais
  
  ano <- ifelse(is.null(resultado$ano),
                max(resultado$populacao$ano),
                resultado$ano)
  
  dados <- dbGetQuery(con, glue("
    SELECT a.idade, s.codigo_sexo, SUM(p.populacao) as pop
    FROM fato_populacao p
    JOIN dim_pais c ON p.id_pais = c.id_pais
    JOIN dim_tempo t ON p.id_tempo = t.id_tempo
    JOIN dim_idade a ON p.id_idade = a.id_idade
    JOIN dim_sexo s ON p.id_sexo = s.id_sexo
    WHERE c.codigo_geo = '{codigo_pais}'
      AND t.ano = {ano}
      AND s.codigo_sexo IN ('M','F')
    GROUP BY a.idade, s.codigo_sexo
    ORDER BY a.idade
  "))
  
  dados$pop <- ifelse(dados$codigo_sexo == "M", -dados$pop, dados$pop)
  
  ggplot(dados, aes(x = idade, y = pop, fill = codigo_sexo)) +
    geom_bar(stat = "identity") +
    coord_flip() +
    labs(
      title = paste("Pirâmide Etária -", codigo_pais, ano),
      x = "Idade",
      y = "População"
    )
}

